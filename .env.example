# --- SAP Logon / credentials ---
SAP_LOGON_PATH=C:\Program Files (x86)\SAP\FrontEnd\SAPgui\saplogon.exe
# Connection name exactly as shown in SAP Logon (e.g. "QAS - Calidad")
SAP_CONNECTION=QAS
SAP_CLIENT=300
SAP_USER=
SAP_PASSWORD=
SAP_LANGUAGE=ES

# --- Purchase order defaults (seen in the ME21N walkthrough) ---
PO_PURCH_ORG=DA00
PO_PURCH_GROUP=025
PO_COMPANY_CODE=DA25
PO_PAYMENT_DAYS=7
PO_ACCT_ASSIGNMENT=1
PO_ITEM_CATEGORY=F
PO_SHORT_TEXT=TRANSPORTE
PO_QUANTITY=1
PO_UNIT=UP
PO_MATERIAL_GROUP=TRANSPORT
# Plant (Centro): Elogia Soluciones Logisticas SAS
PO_PLANT=2500
# VAT indicator for the service line
PO_TAX_CODE=VC
PO_SERVICE_NUMBER=4220
PO_SERVICE_QTY=1
PO_GL_ACCOUNT=2815052000
